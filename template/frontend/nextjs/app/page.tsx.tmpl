"use client";

import Link from "next/link";
import { useEffect, useState } from "react";

const API = process.env.NEXT_PUBLIC_API_ORIGIN ?? "http://localhost:8080";

// The ToGO mark — six-cube lattice (https://to-go.dev/en/brand). Body follows the text colour,
// the accent cubes stay teal.
function ToGOMark({ className }: { className?: string }) {
  return (
    <svg viewBox="0 0 100 100" role="img" aria-label="ToGO" shapeRendering="crispEdges" className={className}>
      <rect x="8" y="29" width="21" height="21" fill="currentColor" />
      <rect x="29" y="8" width="21" height="21" fill="currentColor" />
      <rect x="29" y="50" width="21" height="21" fill="currentColor" />
      <rect x="50" y="29" width="21" height="21" fill="#1F8A99" />
      <rect x="50" y="71" width="21" height="21" fill="#1F8A99" />
      <rect x="71" y="50" width="21" height="21" fill="#1F8A99" />
    </svg>
  );
}

// Welcome screen — SPA navigation via next/link; doc links point at the API origin.
export default function Welcome() {
  const [health, setHealth] = useState<{ status?: string; togo?: string } | null>(null);

  useEffect(() => {
    fetch(`${API}/api/health`).then((r) => r.json()).then(setHealth).catch(() => setHealth(null));
  }, []);

  return (
    <main className="flex min-h-screen flex-col items-center justify-center bg-background px-6 text-foreground">
      <div className="w-full max-w-md border border-border bg-card">
        <div className="p-8 text-center">
          <ToGOMark className="mx-auto mb-6 h-16 w-16 text-foreground" />
          <h1 className="text-5xl font-medium tracking-tight">{{.AppPascal}}</h1>
          <p className="mt-3 text-muted-foreground">Built with togo — sign in to your dashboard.</p>
        </div>

        <div className="tg-hatch h-3 border-y border-border" />

        <div className="space-y-3 p-8">
          <Link href="/login" className="block w-full rounded-md bg-primary py-3 text-center font-medium text-primary-foreground transition-colors hover:bg-primary/90">
            Log in
          </Link>
          <Link href="/register" className="block w-full rounded-md border border-border py-3 text-center font-medium transition-colors hover:bg-accent">
            Create account
          </Link>
          <Link href="/dashboard" className="block pt-2 text-center text-sm text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline">
            Go to dashboard →
          </Link>
        </div>
      </div>

      <div className="mt-8 flex items-center justify-center gap-4 font-mono text-xs text-muted-foreground">
        <span className="inline-flex items-center gap-1.5">
          <span className={`h-2 w-2 rounded-full ${health?.status === "ok" ? "bg-emerald-500" : "bg-muted-foreground/40"}`} />
          API {health?.status === "ok" ? "connected" : "offline"}
        </span>
        <span>·</span>
        <a href={`${API}/docs`} className="transition-colors hover:text-foreground">REST docs</a>
        <span>·</span>
        <a href={`${API}/graphql/play`} className="transition-colors hover:text-foreground">GraphQL</a>
      </div>
      <p className="mt-3 font-mono text-xs text-muted-foreground/70">togo {health?.togo ?? "…"} · powered by Go</p>
    </main>
  );
}
