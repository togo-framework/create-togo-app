{{- /* sqlc's engine must match the SQL that `togo make:resource` writes for the
     configured driver (togo.yaml database.driver). database/sql is the driver
     package, so nullable columns are mapped to pointers by override. */ -}}
version: "2"
sql:
{{- if eq .DBDriver "pgx"}}
  - engine: "postgresql"
    schema: "internal/db/schema"
    queries: "internal/db/queries"
    gen:
      go:
        package: "db"
        out: "internal/db/gen"
        emit_json_tags: true
        emit_db_tags: true
        overrides:
          - db_type: "uuid"
            go_type: "string"
          - db_type: "uuid"
            nullable: true
            go_type: { type: "string", pointer: true }
          - db_type: "text"
            nullable: true
            go_type: { type: "string", pointer: true }
          - db_type: "pg_catalog.int8"
            nullable: true
            go_type: { type: "int64", pointer: true }
          - db_type: "pg_catalog.int4"
            nullable: true
            go_type: { type: "int32", pointer: true }
          - db_type: "pg_catalog.bool"
            nullable: true
            go_type: { type: "bool", pointer: true }
          - db_type: "pg_catalog.float8"
            nullable: true
            go_type: { type: "float64", pointer: true }
          - db_type: "pg_catalog.numeric"
            go_type: "string"
          - db_type: "pg_catalog.numeric"
            nullable: true
            go_type: { type: "string", pointer: true }
          - db_type: "timestamptz"
            nullable: true
            go_type: { import: "time", type: "Time", pointer: true }
          - db_type: "date"
            nullable: true
            go_type: { import: "time", type: "Time", pointer: true }
          - db_type: "jsonb"
            go_type: "string"
          - db_type: "jsonb"
            nullable: true
            go_type: { type: "string", pointer: true }
{{- else if eq .DBDriver "mysql"}}
  - engine: "mysql"
    schema: "internal/db/schema"
    queries: "internal/db/queries"
    gen:
      go:
        package: "db"
        out: "internal/db/gen"
        emit_json_tags: true
        emit_db_tags: true
        overrides:
          - db_type: "char"
            nullable: true
            go_type: { type: "string", pointer: true }
          - db_type: "text"
            nullable: true
            go_type: { type: "string", pointer: true }
          - db_type: "bigint"
            nullable: true
            go_type: { type: "int64", pointer: true }
          - db_type: "int"
            nullable: true
            go_type: { type: "int32", pointer: true }
          - db_type: "tinyint"
            nullable: true
            go_type: { type: "bool", pointer: true }
          - db_type: "double"
            nullable: true
            go_type: { type: "float64", pointer: true }
          - db_type: "decimal"
            go_type: "string"
          - db_type: "decimal"
            nullable: true
            go_type: { type: "string", pointer: true }
          - db_type: "datetime"
            go_type: { import: "time", type: "Time" }
          - db_type: "datetime"
            nullable: true
            go_type: { import: "time", type: "Time", pointer: true }
          - db_type: "date"
            go_type: { import: "time", type: "Time" }
          - db_type: "date"
            nullable: true
            go_type: { import: "time", type: "Time", pointer: true }
          - db_type: "json"
            go_type: "string"
          - db_type: "json"
            nullable: true
            go_type: { type: "string", pointer: true }
{{- else}}
  - engine: "sqlite"
    schema: "internal/db/schema"
    queries: "internal/db/queries"
    gen:
      go:
        package: "db"
        out: "internal/db/gen"
        emit_json_tags: true
        emit_db_tags: true
        emit_pointers_for_null_types: true
        overrides:
          - db_type: "datetime"
            go_type: "time.Time"
{{- end}}
